{
  "schemaVersion": 1,
  "product": "OpenAI Codex CLI — public npm channel snapshot 2026-08-16",
  "expectedVersion": "0.147.0",
  "defaults": {
    "timeoutMs": 120000,
    "maxOutputBytes": 65536
  },
  "channels": [
    {
      "id": "npm-latest",
      "label": "@openai/codex from the public npm registry",
      "executable": "codex",
      "expectedExecutablePath": "${WORK_DIR}/npm-prefix/bin/codex${EXECUTABLE_SUFFIX}",
